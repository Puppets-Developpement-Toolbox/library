{
  "name": "puppets/carlo-dev",
  "type": "project",
  "license": "proprietary",
  "description": "Environnement de développement du plugin Carlo (Bedrock + Lando)",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/wordpress": "^7.0",
    "roots/wp-config": "^1.0",
    "idleberg/wordpress-vite-assets": "^0.9"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  }
}
